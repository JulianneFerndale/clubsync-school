# Rendered at container start with the real $PORT (see docker/entrypoint.sh).
server {
    listen __PORT__;
    listen [::]:__PORT__;
    server_name _;

    root /var/www/html/public;
    index index.php;
    charset utf-8;

    # Allow reasonably sized uploads (e.g. profile photos).
    client_max_body_size 20M;

    # Pages are 40–90 KB of HTML that compress several-fold: less to send over
    # students' mobile data and the server's own uplink.
    gzip on;
    gzip_vary on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_types text/css application/javascript application/json application/manifest+json image/svg+xml;

    # Vite's build files are named by their content hash, so a cached copy can
    # never be stale: let browsers keep them for a year.
    location /build/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location = /favicon.ico { access_log off; log_not_found off; }
    location = /robots.txt  { access_log off; log_not_found off; }

    error_page 404 /index.php;

    location ~ \.php$ {
        fastcgi_pass 127.0.0.1:9000;
        fastcgi_index index.php;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        fastcgi_param DOCUMENT_ROOT $realpath_root;
    }

    # Deny access to hidden files except .well-known.
    location ~ /\.(?!well-known).* {
        deny all;
    }
}
