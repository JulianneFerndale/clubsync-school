[Unit]
Description=ClubSync Reverb websocket server (real-time notifications)
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/clubsync
ExecStart=/usr/bin/php artisan reverb:start --host=0.0.0.0 --port=8080
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
