APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Manila

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=require
DB_CONNECT_TIMEOUT=5
DB_PERSISTENT=true

DB_CAP_MB=500
RETENTION_WARN_PERCENT=75
RETENTION_CRITICAL_PERCENT=90
RETENTION_SESSION_DAYS=7
RETENTION_READ_NOTIF_DAYS=90
RETENTION_AUDIT_DAYS=365
CHAT_RETENTION_DAYS=365

SESSION_DRIVER=file
SESSION_LIFETIME=30
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Default is "log" (emails written to storage/logs, nothing sent).
# To send announcement Gmail copies via the SCC Google Workspace, switch to smtp:
#   MAIL_MAILER=smtp
#   MAIL_HOST=smtp.gmail.com
#   MAIL_PORT=587
#   MAIL_SCHEME=null            # STARTTLS on 587 (use "smtps" + port 465 for SSL)
#   MAIL_USERNAME=clubsync@sccpag.edu.ph
#   MAIL_PASSWORD="<google-workspace-app-password>"   # 16-char App Password (2FA required)
#   MAIL_FROM_ADDRESS="clubsync@sccpag.edu.ph"
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Google Calendar sync — puts confirmed activities, fee due dates and semester dates into
# the personal Google Calendar of each @sccpag.edu.ph user they concern.
# Setup (Google Cloud Console + Workspace super-admin):
#   1. Create a service account, enable the Google Calendar API, generate a JSON key.
#   2. Note the service account's "Client ID"; in the Admin console
#      (Security > API Controls > Domain-wide delegation) authorize that Client ID
#      for scope: https://www.googleapis.com/auth/calendar.events
#   3. Place the JSON key at storage/app/google/service-account.json (git-ignored),
#      or point GOOGLE_SERVICE_ACCOUNT_JSON at it.
#   4. Set GOOGLE_CALENDAR_ENABLED=true, then run `php artisan google-calendar:sync` once
#      to push existing upcoming records. Keep a queue worker running.
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_WORKSPACE_DOMAIN=sccpag.edu.ph
GOOGLE_CALENDAR_TIMEZONE=Asia/Manila

# "Continue with Google" on the login and registration pages — @sccpag.edu.ph Google
# Workspace accounts only (the domain is fixed in code, not here). The button stays
# hidden until both values are set. Full checklist: docs/GOOGLE-SIGN-IN-SETUP.md
#   - Firebase console > Authentication > Sign-in method: enable Google.
#   - Use its "Web SDK configuration" client ID and secret below, and add
#     https://<host>/auth/google/callback to that client's Authorized redirect URIs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only if the callback must differ from APP host + /auth/google/callback (e.g. behind a proxy).
GOOGLE_REDIRECT_URI=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ── Firebase (authentication + realtime database) ─────────────────────────────
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_DATABASE_URL=

# ── Google Gemini (AI announcement drafting) ──────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# ── Outbound HTTP fail-fast (Firebase/Gemini) when offline ────────────────────
HTTP_CONNECT_TIMEOUT=5
